{
  "name": "universal-sheet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "A framework-agnostic spreadsheet SDK — Excel-like canvas engine for Vue 3 and React",
  "author": "liangzai927",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/liangzai927/universal-sheet"
  },
  "homepage": "https://github.com/liangzai927/universal-sheet#readme",
  "bugs": {
    "url": "https://github.com/liangzai927/universal-sheet/issues"
  },
  "keywords": [
    "spreadsheet",
    "excel",
    "canvas",
    "grid",
    "vue",
    "react",
    "typescript"
  ],
  "files": [
    "packages/*/dist"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf packages/*/dist apps/*/dist .turbo",
    "docs:dev": "turbo run docs:dev",
    "docs:build": "turbo run docs:build",
    "prepare": "simple-git-hooks",
    "changeset": "changeset",
    "release": "pnpm build && changeset publish"
  },
  "simple-git-hooks": {
    "pre-commit": "pnpm lint-staged"
  },
  "lint-staged": {
    "*.{ts,tsx,vue}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.0",
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "lint-staged": "^17.0.4",
    "prettier": "^3.8.3",
    "simple-git-hooks": "^2.13.1",
    "turbo": "^2.9.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.1.0"
}
