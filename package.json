{
  "name": "universal-sheet",
  "version": "1.0.0",
  "private": true,
  "description": "A framework-agnostic spreadsheet SDK",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "turbo run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "docs:dev": "turbo run docs:dev",
    "docs:build": "turbo run docs:build"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "eslint": "^10.3.0",
    "prettier": "^3.8.3",
    "turbo": "^2.9.12",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@9.1.0"
}
